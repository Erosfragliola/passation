# Names of the environment variables used by the Worker, without any value.
# Locally, Wrangler reads them from .dev.vars (copy .dev.vars.example to .dev.vars and fill it in yourself; never
# commit it). .env.example and .dev.vars.example list the same variables. In production, each value is set with:
#   npx wrangler secret put NAME
ANTHROPIC_API_KEY=
BREVO_API_KEY=
SENDER_EMAIL=
SENDER_NAME=
SESSION_SECRET=
