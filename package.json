{
  "name": "passation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Toolbox for SME owners preparing the sale of their business",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply passation --local",
    "deploy": "wrangler deploy",
    "images": "node scripts/images.mjs",
    "fixtures": "node scripts/fixtures.mjs",
    "multiples": "node scripts/multiples.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "demo:video": "node scripts/video-demo.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.64.1",
    "sharp": "0.35.5",
    "vitest": "4.1.12",
    "wrangler": "4.162.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "fflate": "0.8.3"
  }
}
